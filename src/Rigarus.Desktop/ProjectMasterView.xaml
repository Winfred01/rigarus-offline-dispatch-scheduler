<UserControl x:Class="Rigarus.Desktop.ProjectMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="OnVisibilityChanged" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary Source="ProjectControls.xaml" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Projects" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Unscheduled backlog" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="_New project" AutomationProperties.AutomationId="NewProject"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource ProjectPrimaryButton}" Click="NewProject_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="Search by Job #, Site ID or site name" Target="{Binding ElementName=SearchInput}"
                           Padding="0,0,0,5" Foreground="{StaticResource Muted}" />
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="_Search" Style="{StaticResource ProjectButton}"
                                AutomationProperties.AutomationId="SearchProjects" Margin="8,0,0,0" Click="Search_Click" />
                        <TextBox x:Name="SearchInput" Style="{StaticResource ProjectInput}"
                                 AutomationProperties.AutomationId="ProjectSearch"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Search_KeyDown" />
                    </DockPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding ResultsText}" Margin="0,10,0,10" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ProjectResults" AutomationProperties.LiveSetting="Polite"
                           Foreground="{StaticResource Muted}" />
                <Grid Grid.Row="2" Margin="10,0,12,6" TextElement.Foreground="{StaticResource Muted}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Job # / Site name" />
                    <TextBlock Grid.Column="1" Text="Site ID" />
                    <TextBlock Grid.Column="2" Text="Work items" TextAlignment="Right" />
                </Grid>
                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedProject}"
                             AutomationProperties.AutomationId="ProjectBacklog" AutomationProperties.Name="Unscheduled backlog"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0" Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding JobNumber}" />
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding JobNumber, StringFormat='ProjectRow-{0}'}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Padding="10,7" MinHeight="49" Background="Transparent"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#F1F5F7" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Selected}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{Binding JobNumber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding JobNumber}" />
                                        <TextBlock Text="{Binding SiteName}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SiteName}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SiteId}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SiteId}" />
                                    <TextBlock Grid.Column="2" Text="{Binding WorkItemCount}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="10,13,10,0" IsHitTestVisible="False"
                               Foreground="{StaticResource Muted}" AutomationProperties.AutomationId="EmptyProjects" />
                </Grid>
            </Grid>

            <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                <Grid>
                    <TextBlock Text="Select a project to see its site and work items." TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentControl Content="{Binding Detail}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,16">
                                        <Button DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource ProjectButton}"
                                                VerticalAlignment="Top" Margin="8,0,0,0" Click="EditProject_Click"
                                                AutomationProperties.AutomationId="EditProject" />
                                        <TextBlock Text="{Binding JobNumber}" FontSize="20" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="DetailJobNumber" />
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Site name" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding SiteName}" FontSize="16" TextWrapping="Wrap" Margin="0,3,0,12"
                                                       AutomationProperties.AutomationId="DetailSiteName" />
                                            <TextBlock Text="Site ID" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding SiteId}" TextWrapping="Wrap" Margin="0,3,0,20"
                                                       AutomationProperties.AutomationId="DetailSiteId" />
                                            <TextBlock Text="Work items" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <TextBlock Text="No work items yet." Foreground="{StaticResource Muted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WorkItems.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Grid Margin="0,0,0,4" TextElement.Foreground="{StaticResource Muted}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WorkItems.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="92" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Type" />
                                                <TextBlock Grid.Column="1" Text="Crews" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="Half-days" TextAlignment="Right" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding WorkItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="70" />
                                                                    <ColumnDefinition Width="92" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Type}" FontWeight="SemiBold"
                                                                           AutomationProperties.AutomationId="DetailWorkItemType" />
                                                                <TextBlock Grid.Column="1" Text="{Binding RequiredCrewCount}" TextAlignment="Right" />
                                                                <TextBlock Grid.Column="2" Text="{Binding EstimatedHalfDays}"
                                                                           AutomationProperties.AutomationId="DetailWorkItemEstimate" TextAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
