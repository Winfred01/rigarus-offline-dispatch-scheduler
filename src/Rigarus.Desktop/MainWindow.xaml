<Window x:Class="Rigarus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:Rigarus.Domain;assembly=Rigarus.Domain"
        xmlns:local="clr-namespace:Rigarus.Desktop"
        Title="Rigarus Offline Dispatch Scheduler"
        Width="1150" Height="720" MinWidth="900" MinHeight="590"
        Background="#EDF2F5" Foreground="#182B36" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="195" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="18,24">
            <StackPanel>
                <TextBlock Text="Rigarus Dispatch" FontSize="17" FontWeight="SemiBold" />
                <ListBox Margin="0,26,0,0" SelectedIndex="0" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Navigation">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#182B36" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent"
                                                BorderThickness="2,0,0,0" BorderBrush="Transparent" CornerRadius="4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="#E1E9EE" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="#DCE7ED" />
                                                <Setter TargetName="Surface" Property="BorderBrush" Value="#205853" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#657884" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Dashboard" />
                    <ListBoxItem x:Name="ProjectsNavigation" Content="Projects"
                                 IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="ProjectsNavigation" />
                    <ListBoxItem Content="Crews &amp; Employees" IsEnabled="False" />
                    <ListBoxItem Content="Rigs" IsEnabled="False" />
                    <ListBoxItem Content="Weekly Schedule" IsEnabled="False" />
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, ElementName=ProjectsNavigation}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="32,28">
                <TextBlock Text="Rigarus Offline Dispatch Scheduler" FontSize="24"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <Border Margin="0,10,0,20" Padding="8,4" HorizontalAlignment="Left"
                        Background="#E0EEE7" CornerRadius="4">
                    <TextBlock Text="Demo Mode" Foreground="#20553A" FontWeight="SemiBold" AutomationProperties.AutomationId="DemoMode" />
                </Border>

                <Border Background="White" BorderBrush="#D2DBE1" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Synthetic project" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectLabel, Mode=OneWay}" Margin="0,6,0,12"
                                   AutomationProperties.AutomationId="ProjectLabel" />
                        <Label Content="_Demo note" Target="{Binding ElementName=NoteInput}" Padding="0,0,0,6" />
                        <TextBox x:Name="NoteInput" Padding="8" MinHeight="36"
                                 MaxLength="{x:Static domain:DemoProject.MaximumNoteLength}"
                                 IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="DemoNote"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="_Save note" Padding="14,7" HorizontalAlignment="Left" Margin="0,12,0,0"
                                IsEnabled="{Binding CanEdit}" Click="SaveNote_Click"
                                AutomationProperties.AutomationId="SaveNote" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   AutomationProperties.AutomationId="DemoStatus" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" Margin="8,8,8,8" Background="White"
                BorderBrush="#DCE5EB" BorderThickness="1" CornerRadius="12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, ElementName=ProjectsNavigation}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <local:ProjectMasterView DataContext="{Binding Projects}" />
        </Border>
    </Grid>
</Window>
